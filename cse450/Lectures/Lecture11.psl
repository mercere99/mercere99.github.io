console.log('hypot = ' + result);
```
!anim explain text The hypotenuse is 5.
---
### A Minimal HTML Page
[page] @(70, 150) {$code, w=850px, size=21px} ```html
<p id="result">Loading...</p>
<script>
  async function run_program() {
    const response = await fetch('hypotenuse.wasm');
    if (!response.ok) throw Error(response.status);
    const bytes = await response.arrayBuffer();
    const { instance } =
      await WebAssembly.instantiate(bytes);
    const { CalcHypotenuse } = instance.exports;
    document.querySelector('#result').textContent =
      CalcHypotenuse(3, 4);
  }
  run_program().catch(error => {
    document.querySelector('#result').textContent =
      'Could not run Wasm: ' + error.message;
  });
</script>
```
[explain] @(955, 175) {$note, w=245px, size=26px, color=explain} The async function waits for the binary before calling the export.
...
[result] @(955, 390) {$note, w=245px, size=27px, color=emp} The page displays 5.
[demo] @(955, 490) {$note, w=245px, size=25px} The complete example adds inputs and a Calculate button.
% API: https://developer.mozilla.org/en-US/docs/WebAssembly/Reference/JavaScript_interface/instantiate_static
