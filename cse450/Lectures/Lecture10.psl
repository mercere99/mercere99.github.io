% PowerPoint slides 85–87.
### Putting the Code in an HTML Script
[async] @(70, 170) {$code, w=820px, size=21px} ```javascript
async function run_program() {
  const wasm_file = await fetch('hypotenuse.wasm');
  const buffer = await wasm_file.arrayBuffer();
  const module = await WebAssembly.instantiate(buffer);
  const { CalcHypotenuse } = module.instance.exports;

  const x = 3.0; const y = 4.0;
  const result = CalcHypotenuse(x, y);
  console.log('Side1 = ' + x + '; Side2 = ' + y);
  console.log('hypot = ' + result);
}
run_program();
```
[explain] @(925, 185) {$note, w=285px, size=27px, color=explain} Wrap the awaits in an async function, then call it.
...
!anim async hide 0.15s
[html] @(70, 170) {$code, w=820px, size=21px} ```html
<script>
  async function run_program() {
    const wasm_file = await fetch('hypotenuse.wasm');
    const buffer = await wasm_file.arrayBuffer();
    const module = await WebAssembly.instantiate(buffer);
    const { CalcHypotenuse } = module.instance.exports;
  
    const x = 3.0; const y = 4.0;
    const result = CalcHypotenuse(x, y);
    console.log('Side1 = ' + x + '; Side2 = ' + y);
    console.log('hypot = ' + result);
  }
  run_program();
</script>
```
!anim explain text Place the JavaScript inside an HTML script element.
...
!anim html hide 0.15s
[page] @(70, 170) {$code, w=820px, size=21px} ```html
<script>
  async function run_program() {
    const wasm_file = await fetch('hypotenuse.wasm');
    const buffer = await wasm_file.arrayBuffer();
    const module = await WebAssembly.instantiate(buffer);
    const { CalcHypotenuse } = module.instance.exports;
  
    const x = 3.0; const y = 4.0;
    const result = CalcHypotenuse(x, y);
    document.body.innerHTML =
      `<p>Side1=${x}; Side2=${y}; Hypotenuse=${result}</p>`;
  }
  run_program();
</script>
```
!anim explain text Or display the result in the page body.
[result] @(925, 410) {$note, w=285px, size=26px, color=emp} Side1=3; Side2=4; Hypotenuse=5
