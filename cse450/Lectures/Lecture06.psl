!set baseurl https://www.cse.msu.edu/~cse450/Lectures/Lecture06.psl
!set bg #08111F
!set color #F4F1E8
!set accent #5DE4C7
!set font Helvetica, Arial, sans-serif
!set headfont Helvetica, Arial, sans-serif
!set linkcolor #ccccff
!set visitedlinkcolor #ccccff

!set palette neon_blue #40C0FF
!set palette neon_pink #FF40C0
!set palette neon_green #C0FF40
!set palette warn red
!set palette math yellow
!set palette emp #80FF80

!set palette id lightblue
!set palette keyword #FF00FF
!set palette quote green
!set palette num tan
!set palette bright #73FDFF
!set palette bg #08111F
% Adapted from Lecture-06 - Parsing2.pptx (32 source slides).
% Hidden source slides 14 and 15 are omitted.
% Repeated PowerPoint frames become click steps, with objects reused in place.
% ... waits for a click; >>> finishes the current motion before continuing.
% Each section lists its source slides. Geometry uses a 1280 x 720 canvas.
% The parsing trace completes the example beyond the last PowerPoint trace row.

!set size 30
!style body {size=30px, w=1112px}
!style note {size=27px, w=1112px}
!style code {font=Menlo, size=28px, w=520px, pad=14px, fill=#102233, color=#F4F1E8, stroke=#31505F}
!style rule {size=28px, w=530px, color=id}
!style node {size=24px, w=110px, color=id, align=center, anchor=center}
!style edge {color=#8AA5B5, thick=2}
!style table {w=1112px, size=26px, pad=12px, headerfill=#173749, headertext=#F4F1E8, bodytext=#F4F1E8, stripe=#102233, stroke=#31505F}

% PowerPoint slide 1.
# CSE450 Translation of Programming Languages
## Lecture 6 : Hacking a Parser
---
% PowerPoint slides 2.
### Ambiguity Example: 2 − 1 + 1
@(84, 160) {$code, w=1112px, size=27px} ```
Start → Expr
Expr → Expr Op Expr
Expr → Int
Expr → Open Expr Close
```
...
[question] @(84, 365) {$body} Which `Expr Op Expr` should we reduce first?
[left] @(84, 440) {$rule} {{color=orange|Expr Op Expr}} Op Expr
[right] @(690, 440) {$rule} Expr Op {{color=orange|Expr Op Expr}}
...
[left1] @(84, 495) {$rule} Expr Op Expr
[right1] @(690, 495) {$rule} Expr Op Expr
...
[left2] @(84, 550) {$rule} Expr → Start
[right2] @(690, 550) {$rule} Expr → Start
...
[left3] @(84, 620) {$body, color=emp, w=530px} `(2 - 1) + 1`
[right3] @(690, 620) {$body, color=neon_pink, w=530px} `2 - (1 + 1)`
