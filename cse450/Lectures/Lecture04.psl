...
[l0] Consider the following pseudocode:
...
@(84, ${start}) [l1] {$code} String Duplicate(String input, Int num_copies):
@(84, ${start+spacing}) [l2] {$code} &nbsp;&nbsp;String out
@(84, ${start+spacing*2}) [l3] {$code} &nbsp;&nbsp;for (Int i in 0 to num_copies):
@(84, ${start+spacing*3}) [l4] {$code} &nbsp;&nbsp;&nbsp;&nbsp;out += input
@(84, ${start+spacing*4}) [l5] {$code} &nbsp;&nbsp;return out
@(84, ${start+spacing*6}) [l6] {$code} main:
@(84, ${start+spacing*7}) [l7] {$code} &nbsp;&nbsp;String hello = "hello"
@(84, ${start+spacing*8}) [l8] {$code} &nbsp;&nbsp;print(Duplicate(hello))
...
