  font=Menlo, size=28px, w=1112px
}

{$code} struct {{color=yellow|SymbolInfo}} {
{$code} &nbsp; {{color=num|std::string}} {{color=emp|name}};
{$code} &nbsp; {{color=num|value_type}} {{color=emp|value}};
{$code} &nbsp; {{color=num|size_t}} {{color=emp|line_num}};
{$code} &nbsp; …
{$code} };
...
{size=180} @(460,85) }
{size=60} @(560,120) Info about indiviudals identifiers goes here!
&nbsp;

...
{$code} class SymbolTable {
...
{$code} &nbsp; using {{color=orange|var_map_t}} = {{color=#ff80ff|std::unordered_map}}<{{color=num|std::string}}, {{color=yellow|SymbolInfo}}>;
...
{size=50, color=lightblue} @(760,340) Map of names to ID info (ONE scope)
{color=lightblue, thick=4} !arrow (600,500) (740,420)
...
{$code} &nbsp; {{color=cyan|std::vector}}<{{color=orange|var_map_t}}> {{color=emp|var_maps}};
{$code} };
...
{size=50, color=lightblue} @(720,600) Stack of scopes!
{color=lightblue, thick=4} !arrow (300,600) (710,630)

---
### Symbol Table Entries
What information do we need in a symbol table entry for a **variable**?
...
[p1a] - {{color=emp|Name}}
...
[p1b] - {{color=emp|Current Value}} (if we are interpreting the code)
...
[p2a] - {{color=emp|Line Number}} (for reporting errors)
...
[p2b] - {{color=emp|Scope}} (so we know when to deactivate it)
...
[p3a] - {{color=emp|Type}} (so we know where it can be used)
...
[p4a] - {{color=emp|Memory Size}} (How much memory to allocate)
...
[p4b] - {{color=emp|Memory Position}} (for compiling to assembly)
...
[p5a] - {{color=emp|Initialized?}} (for compile-time error checking)
...
{size=90px, color=cyan} @(750,200) }
{size=60px, color=cyan} @(800,225) Project 1
